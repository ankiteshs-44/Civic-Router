# Copy this file to `.env` in the backend/ directory and fill in real values.

# --- OpenAI / LLM ---
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint. Leave blank for OpenAI.
OPENAI_BASE_URL=
# Model used for routing. gpt-4o-mini supports vision + JSON mode.
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
# SQLite database file (relative paths resolve against the current directory).
DB_PATH=complaints.db
# Hard timeout (seconds) for the AI call before falling back to the regex router.
AI_TIMEOUT_SECONDS=8
# NMMC Disaster Management helpline, forced for high-urgency complaints.
NMMC_DISASTER_NUMBER=1800-222-309
# Comma-separated CORS origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173