{
  "name": "civic-complaint-router",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Civic Complaint Router for Navi Mumbai - routes a plain-language citizen complaint to the right authority, letter, portal and escalation timeline.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "build:linux": "npm run build && electron-builder --linux deb --x64",
    "build:windows": "npm run build && electron-builder --win nsis --x64",
    "build:android": "npm run build && cap sync android && node scripts/build-android.mjs"
  },
  "main": "desktop/main.cjs",
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "org.civicrouter.app",
    "productName": "Civic Router",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "frontend/dist/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "Civic Router maintainers",
      "target": [
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
