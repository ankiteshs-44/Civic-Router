# Base URL of the backend complaint API.
# Leave empty to always use the local mock responses (handy for demos/hackathons).
# When set, the frontend will POST to {VITE_API_URL}/complain with { "text": "..." }.
# If the request fails or takes longer than 15s, the app falls back to mocks.
VITE_API_URL=

# --- AI module (Python) -------------------------------------------------------
# Copy this file to `.env` and fill these in. They are only needed once the real
# LLM client (ai_module/llm_client.py) is implemented; the current stub runs
# without them.

# API key for your LLM provider.
LLM_API_KEY=

# Base URL of an OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
LLM_BASE_URL=

# Model name to call, e.g. gpt-4o-mini
LLM_MODEL=
