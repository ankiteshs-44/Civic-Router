# Base URL of the FastAPI backend.
# Leave empty to always use local mock responses (handy for demos/hackathons).
# When set, the frontend POSTs to {VITE_API_URL}/complain with
# { text, image_base64, language }.
# If the request fails or exceeds the client timeout, the app falls back to mocks
# and shows a "Demo Mode" badge.
VITE_API_URL=http://localhost:8000